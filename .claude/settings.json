{
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build ./...)",
      "Bash(go version:*)",
      "Bash(gofmt -l .)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 state)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 inbox)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 migrate-status)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 test)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 build)",
      "Bash(curl -s http://127.0.0.1:8080/healthz)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list)",
      "Bash(tasklist:*)",
      "Bash(date -u:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(docker:*)",
      "Bash(go mod tidy)",
      "Bash(bin/chaos.exe:*)",
      "Bash(./bin/chaos.exe:*)",
      "Bash(bin/worker.exe:*)",
      "Bash(bin/worker-phase4.exe:*)",
      "Bash(bin/naive.exe:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 send:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 up)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 down)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 reset-data)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 db-test)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 migrate)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 psql:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 receiver)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 worker)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 naive)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(taskkill:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File dev.ps1 reset)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(git checkout -- .)",
      "Bash(cat .env:*)",
      "Bash(echo relayguard-deny-canary:*)",
      "Read(./docs/deny-canary.txt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-allowlist.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-handoff.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-handoff.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
